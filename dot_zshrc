# Editor

export EDITOR=nvim


# XDG Paths
export XDG_CONFIG_HOME=$HOME/.config
export XDG_CACHE_HOME=$HOME/.cache
export XDG_DATA_HOME=$HOME/.local/share

#export PATH="$HOME/go/bin":$PATH

zstyle ':completion:*' completer _complete _ignored
zstyle :compinstall filename '/home/sebastian/.zshrc'

# Adding custom location for autocompletion scripts
#fpath=(~/.local/share/zsh/site-functions $fpath)

# Init autocompletion system
autoload -Uz compinit
compinit


# History configuration
HISTFILE=~/.histfile
HISTSIZE=1000
SAVEHIST=1000


# enable ssh-agent 
#if ! pgrep -u "$USER" ssh-agent > /dev/null; then
#    ssh-agent -t 10h > "$XDG_RUNTIME_DIR/ssh-agent.env"
#fi
#if [[ ! "$SSH_AUTH_SOCK" ]]; then
#    source "$XDG_RUNTIME_DIR/ssh-agent.env" >/dev/null
#fi

# set PATH so it includes user's private bin if it exists
if [ -d "$HOME/.local/bin" ]; then
  PATH="$HOME/.local/bin:$PATH"
fi


# edit command line via editor
autoload -z edit-command-line
zle -N edit-command-line
# Use emacs style keepindings in shell
bindkey -e
# Edit command line on ALT + e
bindkey "^[e" edit-command-line
bindkey "^U" backward-kill-line

#source ~/Work/clibook/clibook-zsh-widgets.zsh

# Init starship
eval "$(starship init zsh)"

# Init zoxide and use j to Jump arrount
eval "$(zoxide init zsh --cmd j)"

# rust toolchain
export PATH="$HOME/.cargo/bin:$PATH"

